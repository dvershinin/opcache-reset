<?xml version="1.0"?>
<ruleset name="OPcache Reset Coding Standards">
	<description>WordPress coding standards for OPcache Reset plugin.</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/tests/</exclude-pattern>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/.git/</exclude-pattern>
	<!-- Local-only symlink to the global wordpress-stubs file, created by the
	     `phpstan-phpdoc` target. Tokenizing it exhausts phpcs's memory limit. -->
	<exclude-pattern>/build/</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Rules: WordPress-Extra (includes WordPress-Core + extra strictness) -->
	<rule ref="WordPress-Extra">
		<!-- Allow non-standard class file naming (plugin uses class-in-main-file pattern) -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- shell_exec is intentionally used for cachetool and file cache management -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec">
		<severity>0</severity>
	</rule>

	<!-- is_writable is intentionally used for low-level file cache operations -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_is_writable">
		<severity>0</severity>
	</rule>

	<!--
		Socket I/O in opcache-fastcgi.php requires native PHP functions.
		WP_Filesystem does not support socket communication.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
		<exclude-pattern>opcache-fastcgi.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fread">
		<exclude-pattern>opcache-fastcgi.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>opcache-fastcgi.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>opcache-fastcgi.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors.Discouraged">
		<exclude-pattern>opcache-fastcgi.php</exclude-pattern>
	</rule>

	<!-- Require minimum WP version for deprecated function checks -->
	<config name="minimum_wp_version" value="5.0"/>
</ruleset>

